# Copy to .env and fill in. Never commit .env.
# On Hugging Face Spaces do NOT use this file -- set GOOGLE_API_KEY as a
# Space Secret instead (Settings -> Variables and secrets -> New secret).

# --- Local development / HF Spaces: Google AI Studio (free tier, no GCP) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-key-here

# Model ID. Verified on AI Studio with function calling (2026-08-20).
# Fallbacks: gemini-3.5-flash, gemini-3.7-flash
# NOTE: gemini-2.5-flash is retired for new API keys -- returns 404.
GOOGLE_GENAI_MODEL=gemini-3.6-flash

# --- Cloud Run: Vertex AI (uses ADC, no key) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
